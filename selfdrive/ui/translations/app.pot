msgstr ""

#: selfdrive/ui/layouts/settings/top.py:102
msgid "Automatic Brake Hold"
msgstr ""

#: selfdrive/ui/layouts/settings/top.py:103
msgid ""
"Activates the car's brakes after 1 seconds stopped. (Only support on Toyota "
"TSS2 Hybrid vehicles)"
msgstr ""

#: selfdrive/ui/layouts/settings/top.py:105
msgid "Fix Toyota BSM Signal"
