#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Quiet Drive"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "TOP will display alerts but only play the most important warning sounds. This feature can be toggled while the car is on."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Driving Screen Off"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Turn off the device screen to protect the OLED panel after driving starts. It automatically brightens or turns on when a touch or event occurs."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Lateral Controls Always On"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Lateral control will always be on and will not be interrupted by braking."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "NNFF Torque Control"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid ""
"Use Twilsonco's Neural Network Feedforward torque system for more precise lateral control.\n"
"Changing this setting will restart openpilot."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Disable Steering Delay Learning"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid ""
"Keep the fixed default steering delay instead of learning the delay of the car while driving. Turn on for cars whose steering wheel sticks: the learned delay comes out too long and the steering can wobble.\n"
"Always on with NNFF Torque Control, which uses the fixed delay. Takes effect on the next drive."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Lane Centering Correction"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "When the driving model keeps the car off the middle of a marked lane, cutting curves or hugging a line, steer it back toward the lane centre. Only from 45 km/h (full from 60 km/h) in normal-width lanes: off in alleys and slow streets, during lane changes, while you steer and where the lane lines are faint. Takes effect on the next drive."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Stop And Go"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enabled the Stop And Go feature and get auto hold."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enable Experiment Mode In SNG"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "When vehicle is stopped, enable experiment mode to prevent radar misjudgment of other moving vehicles that could cause continuous forward sliding."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "TSS-P Longitudinal Tuning"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Using the longitudinal tuning can improve the smoothness on Toyota TSS-P models when equipped with SDSU for longitudinal control."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Dynamic Distance Adjustment"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "The distance to the lead car will no longer be a fixed reaction time, but will be dynamically adjusted based on the speed of the vehicle."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Smooth Stops"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Eases off the brake in the final moments of a stop for a gentle landing. Planned braking is never softened. Requires openpilot longitudinal control."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Blinker Lane Change"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid ""
"Change lanes without the need to nudge the steering wheel first.\n"
"Disabled: Need to nudge the steering wheel to change lanes.\n"
"Enabled: Nudgeless.\n"
"Speed limit: Normal mode: above 20mph, Enabled Lateral Controls Always On: above 35mph."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Edge Detection During Lane Changes"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid ""
"When the system detects obstacles at the vehicle's edge, lane change assist functionality will be temporarily suspended.\n"
"NOTE: This will show 'Car Detected in Blindspot' warning."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Vision Based Turn Control"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Use vision path predictions to estimate the appropriate speed to drive through turns ahead."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Map Based Turn Control"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Use map data to estimate the appropriate speed to drive through turns ahead."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enable Local File Server"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid ""
"This will allow you to play or download openpilot driving record files through your browser.\n"
"Use web interface to control it: http://[device_ip]:8082\n"
"Internet access from mobile phone (tethering) is required."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enable opview"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Stream the road camera and driving display to the opview app (Android, github.com/eFiniLan/opview) on a phone on the same Wi-Fi network as the device, such as the phone's hotspot. Uses extra CPU while driving."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Use Toyota Stock Longitudinal Control"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enable to use Toyota's stock longitudinal control."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enable Toyota Drive Mode Button"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid ""
"TOP will link the Acceleration Personality to the car's physical drive mode selector.\n"
"Reboot Required."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enable Door Auto Lock"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enabled this to lock doors when drive above 25 km/h. Only work on some Toyota vehicles."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enable Door Auto Unlock"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enabled this to unlock doors when shift to gear P. Only work on some Toyota vehicles."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Automatic Brake Hold"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Activates the car's brakes after 1 seconds stopped. (Only support on Toyota TSS2 Hybrid vehicles)"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Fix Toyota BSM Signal"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "Enhance BSM function for some Toyota vehicles that openpilot currently does not support."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid "ACC +/-: Long Press Reverse"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/top_common.py
msgid ""
"Change the ACC +/- buttons behavior with cruise speed change in openpilot.\n"
"Disabled (Stock): Short = 1, Long = 5.\n"
"Enabled: Short and Long = 5."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/firehose.py
msgid "Firehose Mode"
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/firehose.py
msgid ""
"openpilot learns to drive by watching humans, like you, drive.\n"
"\n"
"Firehose Mode allows you to maximize your training data uploads to improve openpilot's driving models. More data means bigger models, which means better Experimental Mode."
msgstr ""

#: openpilot/selfdrive/ui/layouts/settings/firehose.py
msgid ""
"For maximum effectiveness, bring your device inside and connect to a good USB-C adapter and Wi-Fi weekly.\n"
"\n"
"Firehose Mode can also work while you're driving if connected to a hotspot or unlimited SIM card.\n"
"\n"
"\n"
"Frequently Asked Questions\n"
"\n"
"Does it matter how or where I drive? Nope, just drive as you normally would.\n"
"\n"
"Do all of my segments get pulled in Firehose Mode? No, we selectively pull a subset of your segments.\n"
"\n"
"What's a good USB-C adapter? Any fast phone or laptop charger should be fine.\n"
"\n"
"Does it matter which software I run? Yes, only upstream openpilot (and particular forks) are able to be used for training."
msgstr ""

